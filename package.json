{
  "name": "personal-os",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --config workers/api/wrangler.jsonc",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p workers/api/tsconfig.json --noEmit",
    "typecheck": "tsc -b && tsc -p workers/api/tsconfig.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security tests/contracts",
    "vendor:ocr": "node scripts/vendor_ocr_assets.mjs",
    "import:health": "python scripts/import_health_workbook.py",
    "stage:health": "node scripts/stage_health_package.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply personal-os --local --config workers/api/wrangler.jsonc",
    "d1:migrate": "wrangler d1 migrations apply personal-os --remote --config workers/api/wrangler.jsonc",
    "deploy": "npm run vendor:ocr && npm run build && wrangler deploy --config workers/api/wrangler.jsonc",
    "cf-typegen": "wrangler types --config workers/api/wrangler.jsonc workers/api/worker-configuration.d.ts"
  },
  "dependencies": {
    "hono": "4.13.1",
    "jose": "6.2.8",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "oxlint": "1.75.0",
    "typescript": "~6.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
